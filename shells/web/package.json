{
  "name": "quire-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg --release",
    "build:collab": "wasm-pack build ../web-collab --out-dir ../web-collab/pkg --target web --release",
    "build:demo": "vite build demo --config demo/vite.config.mjs",
    "size": "node ../../scripts/check-wasm-size.mjs",
    "test:odt": "node tests/odf_d2_node_smoke.mjs",
    "test:tables": "node tests/e_wasm_table_map_node_smoke.mjs",
    "size:json": "node ../../scripts/check-wasm-size.mjs --json ../../build/wasm-size.json",
    "test:ime": "python3 ../../scripts/ime-inject-test.py",
    "demo": "npm run build:wasm && npm run build:collab && vite demo --config demo/vite.config.mjs"
  },
  "devDependencies": {
    "vite": "^8.3.6",
    "wasm-pack": "^0.15"
  },
  "license": "Apache-2.0"
}
